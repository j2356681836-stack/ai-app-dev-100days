POSTGRES_USER=admin
POSTGRES_PASSWORD=replace_with_your_local_password
POSTGRES_DB=beauty_kb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Day70: AI Query Runtime 专用 PostgreSQL 登录账户。
# 该账户由 `python -m app.db.provision_query_role` 创建或更新。
# 不要与 POSTGRES_USER 使用相同用户名或密码。
AI_QUERY_POSTGRES_USER=beauty_bi_query
AI_QUERY_POSTGRES_PASSWORD=replace_with_a_different_query_password

# Governed SQL Runner 连接池。
AI_QUERY_POOL_SIZE=5
AI_QUERY_MAX_OVERFLOW=5
AI_QUERY_POOL_TIMEOUT_SECONDS=10
AI_QUERY_POOL_RECYCLE_SECONDS=1800
AI_QUERY_APPLICATION_NAME=beauty_bi_governed_query

# PostgreSQL Role 与 Runner 的防御性执行默认值。
AI_QUERY_CONNECTION_LIMIT=10
AI_QUERY_STATEMENT_TIMEOUT_MS=5000

AI_RESULT_TOKENIZATION_SECRET=replace_with_result_tokenization_secret
AI_AUDIT_SECRET=replace_with_a_different_audit_secret
AI_AUDIT_LOG_PATH=_private/runtime/audit_events.jsonl

DEEPSEEK_MODEL=deepseek-v4-pro
