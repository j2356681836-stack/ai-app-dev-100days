# Beauty BI Agent — 环境变量合同
#
# 复制为 .env 后，将所有 CHANGE_ME 替换为真实值。
# 真实 .env 永远不要提交到 Git。
#
# 本机开发：
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5432
#
# Docker Compose 会在应用容器内覆盖为：
#   POSTGRES_HOST=beauty_db
#   POSTGRES_PORT=5432
#
# Render Web Service：
#   POSTGRES_HOST=<Render Internal Hostname>
#   POSTGRES_PORT=5432
#   POSTGRES_HOST 只能填写纯 Hostname，不能填写完整 postgresql:// URL。
#   Web Service 的 PORT 由 Render 在运行时注入，不在这里固定。

# PostgreSQL Owner / Maintenance Runtime
POSTGRES_USER=beauty_admin
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
POSTGRES_DB=beauty_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Governed AI Query Runtime
# 运行时只读账号必须与 Owner 账号、密码分离。
# Day92 Cloud Bootstrap 已创建并验证该最小权限 Role。
AI_QUERY_POSTGRES_USER=beauty_bi_query
AI_QUERY_POSTGRES_PASSWORD=CHANGE_ME_QUERY_PASSWORD
AI_QUERY_POOL_SIZE=5
AI_QUERY_MAX_OVERFLOW=5
AI_QUERY_POOL_TIMEOUT_SECONDS=10
AI_QUERY_POOL_RECYCLE_SECONDS=1800
AI_QUERY_APPLICATION_NAME=beauty_bi_governed_query
AI_QUERY_CONNECTION_LIMIT=10
AI_QUERY_STATEMENT_TIMEOUT_MS=5000

# Governance / Result Protection / Audit
# Secret 长度必须 >= 16 个字符。
AI_RESULT_TOKENIZATION_SECRET=CHANGE_ME_AT_LEAST_16_CHARS
AI_AUDIT_SECRET=CHANGE_ME_AT_LEAST_16_CHARS
AI_AUDIT_LOG_PATH=runtime/audit/audit_events.jsonl
#
# Public Demo 注意：
# 如果 Web Service 使用临时文件系统，该 Audit 文件不会在 restart / redeploy 后长期保留。
# 未接入 durable storage 前，不声称具备长期 Audit Retention。

# LLM Runtime
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=CHANGE_ME_OPENAI_COMPATIBLE_BASE_URL

# Observability / Langfuse
# 默认关闭：缺失或错误的 Observability 配置不能阻塞核心业务 Runtime。
LANGFUSE_OBSERVABILITY_ENABLED=false
LANGFUSE_PUBLIC_KEY=CHANGE_ME_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=CHANGE_ME_LANGFUSE_SECRET_KEY
LANGFUSE_BASE_URL=CHANGE_ME_LANGFUSE_BASE_URL

# Delivery
# 仅用于本地 Docker Compose 的宿主机端口映射。
# 云端 Web Service 使用平台运行时注入的 PORT。
STREAMLIT_PORT=8501

# =========================
# Embedding Runtime
# =========================

AI_EMBEDDING_PROVIDER=openai_compatible
AI_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=