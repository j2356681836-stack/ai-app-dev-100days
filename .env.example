# Beauty BI Agent — Environment Contract
#
# Copy to .env and replace every CHANGE_ME value.
# Never commit the real .env.
#
# Host development:
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5432
#
# Docker Compose overrides application containers to:
#   POSTGRES_HOST=beauty_db
#   POSTGRES_PORT=5432

# PostgreSQL Owner / Maintenance Runtime
POSTGRES_USER=beauty_admin
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
POSTGRES_DB=beauty_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Governed AI Query Runtime
# Must NOT reuse POSTGRES_USER / POSTGRES_PASSWORD.
AI_QUERY_POSTGRES_USER=beauty_ai_query
AI_QUERY_POSTGRES_PASSWORD=CHANGE_ME_QUERY_PASSWORD
AI_QUERY_POOL_SIZE=5
AI_QUERY_MAX_OVERFLOW=5
AI_QUERY_POOL_TIMEOUT_SECONDS=10
AI_QUERY_POOL_RECYCLE_SECONDS=1800
AI_QUERY_APPLICATION_NAME=beauty_bi_governed_query
AI_QUERY_CONNECTION_LIMIT=10
AI_QUERY_STATEMENT_TIMEOUT_MS=5000

# Governance / Result Protection / Audit
# Secrets must be >= 16 characters.
AI_RESULT_TOKENIZATION_SECRET=CHANGE_ME_AT_LEAST_16_CHARS
AI_AUDIT_SECRET=CHANGE_ME_AT_LEAST_16_CHARS
AI_AUDIT_LOG_PATH=runtime/audit/audit_events.jsonl

# LLM Runtime
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=CHANGE_ME_OPENAI_COMPATIBLE_BASE_URL

# Delivery
STREAMLIT_PORT=8501
